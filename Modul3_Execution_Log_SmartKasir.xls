    <Cell ss:StyleID="RowRemoved"><Data ss:Type="String">Remove: duplicate ID 3</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="TableCellCenter"><Data ss:Type="Number">9</Data></Cell>
    <Cell ss:StyleID="TableCellCenter"><Data ss:Type="Number">25</Data></Cell>
    <Cell ss:StyleID="TableCellCenter"><Data ss:Type="Number">49</Data></Cell>
    <Cell ss:StyleID="TableCellCenter"><Data ss:Type="Number">1000000</Data></Cell>
