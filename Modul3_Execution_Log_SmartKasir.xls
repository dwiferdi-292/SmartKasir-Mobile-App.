   <Row ss:Height="26">
    <Cell ss:MergeAcross="4" ss:StyleID="TitleStyle"><Data ss:Type="String">03_EP: EQUIVALENCE PARTITIONING (WEAK ROBUST COVERAGE)</Data></Cell>
   </Row>
   <Row ss:Height="18">
    <Cell ss:MergeAcross="4" ss:StyleID="SubTitleStyle"><Data ss:Type="String">Setiap partisi mewakili kelas perlakuan sistem. Weak Robust menguji 1 invalid per kasus dengan single-fault assumption.</Data></Cell>
   </Row>
   <Row ss:Height="10"></Row>

   <!-- TABEL DEFINISI PARTISI -->
   <Row ss:Height="22"><Cell ss:MergeAcross="4" ss:StyleID="SectionHeader"><Data ss:Type="String">1. Definisi Partisi Domain SmartKasir (Partisi Valid &amp; Invalid)</Data></Cell></Row>
   <Row>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Partisi ID</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Klasifikasi / Nama Partisi</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Aturan / Rentang Nilai</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Nilai Representatif</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Alasan (Why / Oracle Rationale)</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="TableCellBold"><Data ss:Type="String">P1</Data></Cell>
    <Cell ss:StyleID="TableCell"><Data ss:Type="String">Valid Input: Transaksi Normal</Data></Cell>
    <Cell ss:StyleID="TableCell"><Data ss:Type="String">1 &lt;= Q1, Q2 &lt;= 50 dan C &gt;= T</Data></Cell>
    <Cell ss:StyleID="TableCellCenter"><Data ss:Type="String">Q1=25, Q2=25, C=1.000.000</Data></Cell>
    <Cell ss:StyleID="TableCell"><Data ss:Type="String">Semua input berada di dalam batas stok dan uang mencukupi tagihan.</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="TableCellBold"><Data ss:Type="String">P2</Data></Cell>
    <Cell ss:StyleID="TableCell"><Data ss:Type="String">Valid Input: Uang Pas (Kembalian Nol)</Data></Cell>
    <Cell ss:StyleID="TableCell"><Data ss:Type="String">1 &lt;= Q1, Q2 &lt;= 50 dan C = T</Data></Cell>
    <Cell ss:StyleID="TableCellCenter"><Data ss:Type="String">Q1=10, Q2=10, C=300.000</Data></Cell>
    <Cell ss:StyleID="TableCell"><Data ss:Type="String">Uang tunai persis sama dengan total tagihan, transaksi diproses tanpa kembalian.</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="TableCellBold"><Data ss:Type="String">P3</Data></Cell>
    <Cell ss:StyleID="TableCell"><Data ss:Type="String">Valid Input: Uang Tunai Kurang (Underpaid)</Data></Cell>
    <Cell ss:StyleID="TableCell"><Data ss:Type="String">1 &lt;= Q1, Q2 &lt;= 50 dan C &lt; T</Data></Cell>
    <Cell ss:StyleID="TableCellCenter"><Data ss:Type="String">Q1=25, Q2=25, C=500.000</Data></Cell>
    <Cell ss:StyleID="TableCell"><Data ss:Type="String">Nilai input valid secara format, tetapi gagal memenuhi aturan bisnis pembayaran C &gt;= T.</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="TableCellBold"><Data ss:Type="String">P4</Data></Cell>
    <Cell ss:StyleID="TableCell"><Data ss:Type="String">Invalid Input: Q1 di Bawah Minimum</Data></Cell>
    <Cell ss:StyleID="TableCell"><Data ss:Type="String">Q1 &lt; 1 (Q1 = 0 atau nilai negatif)</Data></Cell>
    <Cell ss:StyleID="TableCellCenter"><Data ss:Type="String">Q1=0, Q2=25, C=1.000.000</Data></Cell>
    <Cell ss:StyleID="TableCell"><Data ss:Type="String">Kuantitas nol melanggar batas bawah domain keranjang belanja.</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="TableCellBold"><Data ss:Type="String">P5</Data></Cell>
    <Cell ss:StyleID="TableCell"><Data ss:Type="String">Invalid Input: Q1 Melebihi Maksimum Stok</Data></Cell>
    <Cell ss:StyleID="TableCell"><Data ss:Type="String">Q1 &gt; 50 (Melebihi sisa fisik toko)</Data></Cell>
    <Cell ss:StyleID="TableCellCenter"><Data ss:Type="String">Q1=55, Q2=25, C=1.500.000</Data></Cell>
    <Cell ss:StyleID="TableCell"><Data ss:Type="String">Kuantitas melebihi kapasitas fisik stok barang yang tersedia (stok = 50).</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="TableCellBold"><Data ss:Type="String">P6</Data></Cell>
    <Cell ss:StyleID="TableCell"><Data ss:Type="String">Invalid Input: Q2 di Bawah Minimum</Data></Cell>
    <Cell ss:StyleID="TableCell"><Data ss:Type="String">Q2 &lt; 1 (Q2 = -1 atau nilai negatif)</Data></Cell>
    <Cell ss:StyleID="TableCellCenter"><Data ss:Type="String">Q1=25, Q2=-1, C=1.000.000</Data></Cell>
    <Cell ss:StyleID="TableCell"><Data ss:Type="String">Nilai kuantitas minuman negatif melanggar aturan integritas input.</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="TableCellBold"><Data ss:Type="String">P7</Data></Cell>
    <Cell ss:StyleID="TableCell"><Data ss:Type="String">Invalid Input: Q2 Melebihi Maksimum Stok</Data></Cell>
    <Cell ss:StyleID="TableCell"><Data ss:Type="String">Q2 &gt; 50 (Melebihi sisa fisik toko)</Data></Cell>
    <Cell ss:StyleID="TableCellCenter"><Data ss:Type="String">Q1=25, Q2=60, C=1.500.000</Data></Cell>
    <Cell ss:StyleID="TableCell"><Data ss:Type="String">Kuantitas minuman melebihi kapasitas stok fisik yang ada di toko.</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="TableCellBold"><Data ss:Type="String">P8</Data></Cell>
    <Cell ss:StyleID="TableCell"><Data ss:Type="String">Invalid Input: Pembayaran Tunai Negatif</Data></Cell>
    <Cell ss:StyleID="TableCell"><Data ss:Type="String">C &lt;= 0 (Nominal tunai tidak masuk akal)</Data></Cell>
    <Cell ss:StyleID="TableCellCenter"><Data ss:Type="String">Q1=25, Q2=25, C=-50000</Data></Cell>
    <Cell ss:StyleID="TableCell"><Data ss:Type="String">Input uang tunai bernilai minus/negatif melanggar aturan dasar pembayaran kasir.</Data></Cell>
   </Row>
   <Row ss:Height="12"></Row>

   <!-- TABEL KASUS UJI WEAK ROBUST EP -->
   <Row ss:Height="22"><Cell ss:MergeAcross="4" ss:StyleID="SectionHeader"><Data ss:Type="String">2. Tabel Kasus Uji Weak Robust EP dengan Alasan Kelas (Single-Fault Assumption)</Data></Cell></Row>
   <Row>
    <Cell ss:StyleID="TableHeaderOrange"><Data ss:Type="String">Test Case ID</Data></Cell>
    <Cell ss:StyleID="TableHeaderOrange"><Data ss:Type="String">Tipe Kelas (Class Type / Why)</Data></Cell>
