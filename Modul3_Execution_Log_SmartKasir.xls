    <Cell ss:StyleID="TableCellCenter"><Data ss:Type="Number">2</Data></Cell>
    <Cell ss:StyleID="TableCellCenter"><Data ss:Type="Number">1000000</Data></Cell>
    <Cell ss:StyleID="TableCell"><Data ss:Type="String">Rp 336.000</Data></Cell>
    <Cell ss:StyleID="TableCell"><Data ss:Type="String">Sukses, Kembalian Rp 664.000</Data></Cell>
