 <!-- ============================================================== -->
 <!-- SHEET 1: 01_Proyek                                             -->
 <!-- ============================================================== -->
 <Worksheet ss:Name="01_Proyek">
  <Table ss:DefaultColumnWidth="120" ss:DefaultRowHeight="20">
   <Column ss:Width="180"/>
   <Column ss:Width="420"/>
   <Row ss:Height="26">
    <Cell ss:MergeAcross="1" ss:StyleID="TitleStyle"><Data ss:Type="String">01_PROYEK: IDENTITAS PROYEK &amp; REVIEW TEST BASIS</Data></Cell>
   </Row>
   <Row ss:Height="18">
    <Cell ss:MergeAcross="1" ss:StyleID="SubTitleStyle"><Data ss:Type="String">Praktikum Software Quality Assurance (SQA) - Modul 3 Black Box Functional Testing</Data></Cell>
   </Row>
   <Row ss:Height="10"></Row>

   <!-- IDENTITAS -->
   <Row ss:Height="22"><Cell ss:MergeAcross="1" ss:StyleID="SectionHeader"><Data ss:Type="String">A. Identitas Praktikan &amp; Sistem</Data></Cell></Row>
   <Row><Cell ss:StyleID="TableCellBold"><Data ss:Type="String">Nama Praktikan</Data></Cell><Cell ss:StyleID="TableCell"><Data ss:Type="String">MUCHAMMAD DWI FERDI ILHAM ARIFIN</Data></Cell></Row>
   <Row><Cell ss:StyleID="TableCellBold"><Data ss:Type="String">NIM</Data></Cell><Cell ss:StyleID="TableCell"><Data ss:Type="String">202310370311292</Data></Cell></Row>
   <Row><Cell ss:StyleID="TableCellBold"><Data ss:Type="String">Kelas</Data></Cell><Cell ss:StyleID="TableCell"><Data ss:Type="String">PKPL - B</Data></Cell></Row>
   <Row><Cell ss:StyleID="TableCellBold"><Data ss:Type="String">Aplikasi Proyek</Data></Cell><Cell ss:StyleID="TableCell"><Data ss:Type="String">SmartKasir (Point of Sale System)</Data></Cell></Row>
   <Row><Cell ss:StyleID="TableCellBold"><Data ss:Type="String">Peran yang Diuji</Data></Cell><Cell ss:StyleID="TableCell"><Data ss:Type="String">Kasir (Cashier Module / POS)</Data></Cell></Row>
   <Row><Cell ss:StyleID="TableCellBold"><Data ss:Type="String">URL Deployment Aktif</Data></Cell><Cell ss:StyleID="TableCell"><Data ss:Type="String">https://smartkasir.infinityfreeapp.com/</Data></Cell></Row>
   <Row ss:Height="12"></Row>

   <!-- TEST BASIS REVIEW -->
   <Row ss:Height="22"><Cell ss:MergeAcross="1" ss:StyleID="SectionHeader"><Data ss:Type="String">B. Review Test Basis &amp; Fitur yang Diuji</Data></Cell></Row>
   <Row><Cell ss:StyleID="TableCellBold"><Data ss:Type="String">Fitur yang Diuji</Data></Cell><Cell ss:StyleID="TableCell"><Data ss:Type="String">Validasi Keranjang Belanja &amp; Pembayaran Transaksi Kasir (POS Checkout &amp; Payment)</Data></Cell></Row>
   <Row><Cell ss:StyleID="TableCellBold"><Data ss:Type="String">Kebutuhan Acuan (Test Basis)</Data></Cell><Cell ss:StyleID="TableCell"><Data ss:Type="String">RQ-004, RQ-005, RQ-006, RQ-007, RQ-008 (Modul 1 &amp; Modul 2 TDS/TTM)</Data></Cell></Row>
   <Row><Cell ss:StyleID="TableCellBold"><Data ss:Type="String">Kumpulan Fitur (Feature Set)</Data></Cell><Cell ss:StyleID="TableCell"><Data ss:Type="String">FS-003 (Cart Management) &amp; FS-004 (Checkout &amp; Payment Processing)</Data></Cell></Row>
   <Row><Cell ss:StyleID="TableCellBold"><Data ss:Type="String">Jumlah Variabel Input (n)</Data></Cell><Cell ss:StyleID="TableCell"><Data ss:Type="String">3 Variabel Independen (Q1 = Kuantitas Menu Makanan, Q2 = Kuantitas Menu Minuman, C = Nominal Uang Tunai)</Data></Cell></Row>
   <Row ss:Height="12"></Row>

   <!-- ATURAN DOMAIN -->
   <Row ss:Height="22"><Cell ss:MergeAcross="1" ss:StyleID="SectionHeader"><Data ss:Type="String">C. Aturan Domain &amp; Batasan Input</Data></Cell></Row>
   <Row><Cell ss:StyleID="TableCellBold"><Data ss:Type="String">Aturan C1 (Input Q1)</Data></Cell><Cell ss:StyleID="TableCell"><Data ss:Type="String">1 &lt;= Q1 &lt;= 50 (Kuantitas French Fries, batas stok fisik toko = 50 porsi, Harga = Rp 12.000)</Data></Cell></Row>
   <Row><Cell ss:StyleID="TableCellBold"><Data ss:Type="String">Aturan C2 (Input Q2)</Data></Cell><Cell ss:StyleID="TableCell"><Data ss:Type="String">1 &lt;= Q2 &lt;= 50 (Kuantitas Cafe Latte, batas stok fisik toko = 50 cup, Harga = Rp 18.000)</Data></Cell></Row>
   <Row><Cell ss:StyleID="TableCellBold"><Data ss:Type="String">Aturan C3 (Rumus Total Tagihan T)</Data></Cell><Cell ss:StyleID="TableCell"><Data ss:Type="String">Total Tagihan T = (Q1 * 12.000) + (Q2 * 18.000)</Data></Cell></Row>
   <Row><Cell ss:StyleID="TableCellBold"><Data ss:Type="String">Aturan C4 (Input Uang Tunai C)</Data></Cell><Cell ss:StyleID="TableCell"><Data ss:Type="String">C &gt;= T dan C &lt;= Rp 2.000.000 (Nominal uang tunai harus cukup membayar total belanja)</Data></Cell></Row>
   <Row ss:Height="12"></Row>

   <!-- OUTPUT CLASSES -->
   <Row ss:Height="22"><Cell ss:MergeAcross="1" ss:StyleID="SectionHeader"><Data ss:Type="String">D. Kelas Output yang Dihasilkan</Data></Cell></Row>
   <Row><Cell ss:StyleID="TableCellBold"><Data ss:Type="String">Output 1 (Valid Success)</Data></Cell><Cell ss:StyleID="TableCell"><Data ss:Type="String">Transaksi Berhasil: Stok terpotong, struk belanja tercetak, dan uang kembalian dihitung akurat (Kembalian = C - T)</Data></Cell></Row>
   <Row><Cell ss:StyleID="TableCellBold"><Data ss:Type="String">Output 2 (Reject Underpaid)</Data></Cell><Cell ss:StyleID="TableCell"><Data ss:Type="String">Penolakan Pembayaran: Muncul peringatan error "Uang diterima kurang dari total bayar!" (C &lt; T)</Data></Cell></Row>
   <Row><Cell ss:StyleID="TableCellBold"><Data ss:Type="String">Output 3 (Reject Out-of-Stock)</Data></Cell><Cell ss:StyleID="TableCell"><Data ss:Type="String">Penolakan Kuantitas: Kuantitas dibatasi maksimal sisa stok fisik toko (Q &gt; 50 tidak dapat ditambahkan)</Data></Cell></Row>
  </Table>
 </Worksheet>

 <!-- ============================================================== -->
 <!-- SHEET 2: 02_BVA                                                -->
 <!-- ============================================================== -->
 <Worksheet ss:Name="02_BVA">
  <Table ss:DefaultColumnWidth="100" ss:DefaultRowHeight="20">
   <Column ss:Width="70"/>
   <Column ss:Width="80"/>
   <Column ss:Width="80"/>
   <Column ss:Width="120"/>
   <Column ss:Width="130"/>
   <Column ss:Width="160"/>
   <Column ss:Width="160"/>
   <Row ss:Height="26">
    <Cell ss:MergeAcross="6" ss:StyleID="TitleStyle"><Data ss:Type="String">02_BVA: DERIVASI BOUNDARY VALUE ANALYSIS (RUMUS WAJIB 4n+1)</Data></Cell>
   </Row>
   <Row ss:Height="18">
    <Cell ss:MergeAcross="6" ss:StyleID="SubTitleStyle"><Data ss:Type="String">Turunan 5n kandidat mentah dieleminasi (n-1) tuple all-nominal hingga tersisa tepat 4n+1 kasus unik.</Data></Cell>
   </Row>
   <Row ss:Height="10"></Row>

   <!-- PARAMETER BVA -->
   <Row ss:Height="22"><Cell ss:MergeAcross="6" ss:StyleID="SectionHeader"><Data ss:Type="String">1. Parameter Variabel &amp; 5 Nilai Batas Tradisional</Data></Cell></Row>
   <Row>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Variabel</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Nama Input</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Min</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Min+</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Nominal</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Max-</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Max</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="TableCellCenter"><Data ss:Type="String">a (Q1)</Data></Cell>
    <Cell ss:StyleID="TableCell"><Data ss:Type="String">French Fries (Qty)</Data></Cell>
    <Cell ss:StyleID="TableCellCenter"><Data ss:Type="Number">1</Data></Cell>
    <Cell ss:StyleID="TableCellCenter"><Data ss:Type="Number">2</Data></Cell>
    <Cell ss:StyleID="TableCellCenter"><Data ss:Type="Number">25</Data></Cell>
    <Cell ss:StyleID="TableCellCenter"><Data ss:Type="Number">49</Data></Cell>
    <Cell ss:StyleID="TableCellCenter"><Data ss:Type="Number">50</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="TableCellCenter"><Data ss:Type="String">b (Q2)</Data></Cell>
    <Cell ss:StyleID="TableCell"><Data ss:Type="String">Cafe Latte (Qty)</Data></Cell>
    <Cell ss:StyleID="TableCellCenter"><Data ss:Type="Number">1</Data></Cell>
    <Cell ss:StyleID="TableCellCenter"><Data ss:Type="Number">2</Data></Cell>
    <Cell ss:StyleID="TableCellCenter"><Data ss:Type="Number">25</Data></Cell>
    <Cell ss:StyleID="TableCellCenter"><Data ss:Type="Number">49</Data></Cell>
    <Cell ss:StyleID="TableCellCenter"><Data ss:Type="Number">50</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="TableCellCenter"><Data ss:Type="String">c (C)</Data></Cell>
    <Cell ss:StyleID="TableCell"><Data ss:Type="String">Uang Tunai (Rp)</Data></Cell>
    <Cell ss:StyleID="TableCellCenter"><Data ss:Type="Number">750000</Data></Cell>
    <Cell ss:StyleID="TableCellCenter"><Data ss:Type="Number">751000</Data></Cell>
    <Cell ss:StyleID="TableCellCenter"><Data ss:Type="Number">1000000</Data></Cell>
    <Cell ss:StyleID="TableCellCenter"><Data ss:Type="Number">1999000</Data></Cell>
    <Cell ss:StyleID="TableCellCenter"><Data ss:Type="Number">2000000</Data></Cell>
   </Row>
   <Row><Cell ss:MergeAcross="6" ss:StyleID="SubTitleStyle"><Data ss:Type="String">Catatan: Pada kondisi nominal Q1=25, Q2=25, Total Tagihan T = (25*12.000) + (25*18.000) = Rp 750.000. Maka Min pembayaran = Rp 750.000 (uang pas).</Data></Cell></Row>
   <Row ss:Height="12"></Row>

   <!-- TABEL 15 RAW SEQUENCE -->
   <Row ss:Height="22"><Cell ss:MergeAcross="6" ss:StyleID="SectionHeader"><Data ss:Type="String">2. Derivasi 15 Raw Sequence &amp; Keputusan Deduplikasi (5n = 15)</Data></Cell></Row>
   <Row>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Raw ID</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Q1 (F. Fries)</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Q2 (C. Latte)</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">C (Tunai Rp)</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Total Tagihan (T)</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Expected Output</Data></Cell>
    <Cell ss:StyleID="TableHeader"><Data ss:Type="String">Deduplication Decision</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="TableCellCenter"><Data ss:Type="Number">1</Data></Cell>
