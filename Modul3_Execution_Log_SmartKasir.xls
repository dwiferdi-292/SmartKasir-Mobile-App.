   </Row>
   <Row><Cell ss:StyleID="TableCellBold"><Data ss:Type="String">TC-EP-01</Data></Cell><Cell ss:StyleID="TableCell"><Data ss:Type="String">Valid input: Transaksi Normal</Data></Cell><Cell ss:StyleID="TableCellCenter"><Data ss:Type="String">P1 (Valid)</Data></Cell><Cell ss:StyleID="TableCell"><Data ss:Type="String">Q1=25, Q2=25, C=1.000.000</Data></Cell><Cell ss:StyleID="TableCell"><Data ss:Type="String">Transaksi Berhasil, Kembalian Rp 250.000, Cetak Struk</Data></Cell></Row>
   <Row><Cell ss:StyleID="TableCellBold"><Data ss:Type="String">TC-EP-02</Data></Cell><Cell ss:StyleID="TableCell"><Data ss:Type="String">Valid input: Uang Pas</Data></Cell><Cell ss:StyleID="TableCellCenter"><Data ss:Type="String">P2 (Valid)</Data></Cell><Cell ss:StyleID="TableCell"><Data ss:Type="String">Q1=10, Q2=10, C=300.000</Data></Cell><Cell ss:StyleID="TableCell"><Data ss:Type="String">Transaksi Berhasil, Kembalian Rp 0, Cetak Struk</Data></Cell></Row>
   <Row><Cell ss:StyleID="TableCellBold"><Data ss:Type="String">TC-EP-03</Data></Cell><Cell ss:StyleID="TableCell"><Data ss:Type="String">Valid input: Pelanggan Bayar Kurang</Data></Cell><Cell ss:StyleID="TableCellCenter"><Data ss:Type="String">P3 (Valid Range)</Data></Cell><Cell ss:StyleID="TableCell"><Data ss:Type="String">Q1=25, Q2=25, C=500.000</Data></Cell><Cell ss:StyleID="TableCell"><Data ss:Type="String">Tolak: Pesan "Uang diterima kurang dari total bayar!"</Data></Cell></Row>
   <Row><Cell ss:StyleID="TableCellBold"><Data ss:Type="String">TC-EP-04</Data></Cell><Cell ss:StyleID="TableCell"><Data ss:Type="String">Invalid input: Q1 below lower bound</Data></Cell><Cell ss:StyleID="TableCellCenter"><Data ss:Type="String">P4 (Invalid Q1)</Data></Cell><Cell ss:StyleID="TableCell"><Data ss:Type="String">Q1=0, Q2=25, C=1.000.000</Data></Cell><Cell ss:StyleID="TableCell"><Data ss:Type="String">Tolak penambahan item / Kuantitas minimal 1</Data></Cell></Row>
   <Row><Cell ss:StyleID="TableCellBold"><Data ss:Type="String">TC-EP-05</Data></Cell><Cell ss:StyleID="TableCell"><Data ss:Type="String">Invalid input: Q1 above upper bound</Data></Cell><Cell ss:StyleID="TableCellCenter"><Data ss:Type="String">P5 (Invalid Q1)</Data></Cell><Cell ss:StyleID="TableCell"><Data ss:Type="String">Q1=55, Q2=25, C=1.500.000</Data></Cell><Cell ss:StyleID="TableCell"><Data ss:Type="String">Tolak: Kuantitas dibatasi maksimal stok 50 porsi</Data></Cell></Row>
   <Row><Cell ss:StyleID="TableCellBold"><Data ss:Type="String">TC-EP-06</Data></Cell><Cell ss:StyleID="TableCell"><Data ss:Type="String">Invalid input: Q2 below lower bound</Data></Cell><Cell ss:StyleID="TableCellCenter"><Data ss:Type="String">P6 (Invalid Q2)</Data></Cell><Cell ss:StyleID="TableCell"><Data ss:Type="String">Q1=25, Q2=-1, C=1.000.000</Data></Cell><Cell ss:StyleID="TableCell"><Data ss:Type="String">Tolak penambahan item / Nilai minus tidak diizinkan</Data></Cell></Row>
   <Row><Cell ss:StyleID="TableCellBold"><Data ss:Type="String">TC-EP-07</Data></Cell><Cell ss:StyleID="TableCell"><Data ss:Type="String">Invalid input: Q2 above upper bound</Data></Cell><Cell ss:StyleID="TableCellCenter"><Data ss:Type="String">P7 (Invalid Q2)</Data></Cell><Cell ss:StyleID="TableCell"><Data ss:Type="String">Q1=25, Q2=60, C=1.500.000</Data></Cell><Cell ss:StyleID="TableCell"><Data ss:Type="String">Tolak: Kuantitas dibatasi maksimal stok 50 cup</Data></Cell></Row>
   <Row><Cell ss:StyleID="TableCellBold"><Data ss:Type="String">TC-EP-08</Data></Cell><Cell ss:StyleID="TableCell"><Data ss:Type="String">Invalid input: C below lower bound</Data></Cell><Cell ss:StyleID="TableCellCenter"><Data ss:Type="String">P8 (Invalid C)</Data></Cell><Cell ss:StyleID="TableCell"><Data ss:Type="String">Q1=25, Q2=25, C=-50000</Data></Cell><Cell ss:StyleID="TableCell"><Data ss:Type="String">Tolak: Uang tunai tidak valid / tombol bayar dinonaktifkan</Data></Cell></Row>
