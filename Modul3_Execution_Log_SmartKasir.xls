    <Cell ss:StyleID="TableCellCenter"><Data ss:Type="Number">1000000</Data></Cell>
    <Cell ss:StyleID="TableCell"><Data ss:Type="String">Rp 474.000</Data></Cell>
    <Cell ss:StyleID="TableCell"><Data ss:Type="String">Sukses, Kembalian Rp 526.000</Data></Cell>
    <Cell ss:StyleID="TableCellBold"><Data ss:Type="String">Keep (Min+ a)</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="TableCellCenter"><Data ss:Type="Number">3</Data></Cell>
