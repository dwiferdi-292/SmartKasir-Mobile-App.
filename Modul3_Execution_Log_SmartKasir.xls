    <Cell ss:StyleID="TableCellBold"><Data ss:Type="String">Keep (Max a)</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="TableCellCenter"><Data ss:Type="Number">6</Data></Cell>
