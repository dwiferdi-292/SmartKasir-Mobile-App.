    <Cell ss:StyleID="TableCellCenter"><Data ss:Type="Number">1000000</Data></Cell>
    <Cell ss:StyleID="TableCell"><Data ss:Type="String">Rp 1.038.000</Data></Cell>
    <Cell ss:StyleID="TableCell"><Data ss:Type="String">Tolak (C &lt; T, Uang Kurang)</Data></Cell>
    <Cell ss:StyleID="TableCellBold"><Data ss:Type="String">Keep (Max- a)</Data></Cell>
   </Row>
   <Row>
