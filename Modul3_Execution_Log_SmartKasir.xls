    <Cell ss:StyleID="TableCell"><Data ss:Type="String">Tolak (C &lt; T, Uang Kurang)</Data></Cell>
    <Cell ss:StyleID="TableCellBold"><Data ss:Type="String">Keep (Max- b)</Data></Cell>
   </Row>
