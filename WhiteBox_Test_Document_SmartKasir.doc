            <td>("Stok habis", 0)</td>
            <td>S1, S2, S4, S6, S7, S12</td>
            <td>{..., <strong>S6</strong>, <strong>S7</strong>}</td>
        </tr>
        <tr>
            <td><strong>TC-04</strong></td>
            <td>cart=[item1], total=24000, cash=50000, method="TUNAI", stock=10</td>
            <td>("Sukses", 26000)</td>
            <td>S1, S2, S4, S6, S8, S9, S11, S12</td>
