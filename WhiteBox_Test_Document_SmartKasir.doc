<h1 class="title">White-box Test Document</h1>
<h2 class="subtitle">&lt;SmartKasir (Point of Sale System)&gt;</h2>

<table>
    <thead>
        <tr>
            <th style="width: 15%;">Version</th>
            <th style="width: 35%;">Author</th>
            <th style="width: 50%;">Description</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>1.0</td>
            <td>Muchammad Dwi Ferdi Ilham Arifin (NIM: 202310370311292)</td>
            <td>Pengujian White-Box (Statement &amp; Branch Coverage) dan Implementasi Unit Testing pada Fitur Transaksi Checkout Kasir POS (FS-004).</td>
        </tr>
    </tbody>
</table>

<h2 class="heading">Statement Coverage</h2>
<p><strong>Function:</strong> <code>process_checkout</code></p>

<div class="code-area">
function process_checkout($cart, $total, $cash, $method, $stock) {<br>
&nbsp;&nbsp;&nbsp;&nbsp;// S1: Inisialisasi variabel status dan kembalian<br>
&nbsp;&nbsp;&nbsp;&nbsp;$status = "";<br>
&nbsp;&nbsp;&nbsp;&nbsp;$change = 0;<br><br>
&nbsp;&nbsp;&nbsp;&nbsp;// S2: Cek apakah keranjang belanja kosong<br>
&nbsp;&nbsp;&nbsp;&nbsp;if (empty($cart)) {<br>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;$status = "Keranjang kosong"; // S3<br>
&nbsp;&nbsp;&nbsp;&nbsp;// S4: Cek apakah nominal uang tunai kurang dari total belanja<br>
&nbsp;&nbsp;&nbsp;&nbsp;} elseif ($cash &lt; $total) {<br>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;$status = "Uang kurang"; // S5<br>
&nbsp;&nbsp;&nbsp;&nbsp;// S6: Cek ketersediaan stok fisik produk<br>
&nbsp;&nbsp;&nbsp;&nbsp;} elseif ($stock &lt;= 0) {<br>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;$status = "Stok habis"; // S7<br>
&nbsp;&nbsp;&nbsp;&nbsp;} else {<br>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;// S8: Cek metode pembayaran untuk kalkulasi uang kembalian<br>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;if ($method === "TUNAI") {<br>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;$change = $cash - $total; // S9<br>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;} else {<br>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;$change = 0; // S10<br>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;}<br>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;$status = "Sukses"; // S11<br>
&nbsp;&nbsp;&nbsp;&nbsp;}<br><br>
&nbsp;&nbsp;&nbsp;&nbsp;// S12: Return hasil transaksi<br>
&nbsp;&nbsp;&nbsp;&nbsp;return [$status, $change];<br>
}
</div>

<p>
<strong>Target:</strong> 100% Statement Coverage<br>
<strong>Total Statement:</strong> 12
</p>

<table>
    <thead>
        <tr>
            <th style="width: 12%;">ID Test</th>
