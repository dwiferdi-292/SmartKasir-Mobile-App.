                <th width="14%">Priority</th>
                <th width="16%">Traceability</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>TCond-001</td>
                <td>FS-001</td>
                <td>Register for an available course with remaining capacity</td>
                <td>High</td>
                <td>RQ-001</td>
            </tr>
            <tr>
                <td>TCond-002</td>
                <td>FS-001</td>
                <td>Register for a course that has reached maximum capacity</td>
                <td>High</td>
                <td>RQ-002</td>
            </tr>
            <tr>
                <td>TCond-003</td>
                <td>FS-001</td>
                <td>Register for a course that the student has already registered for (duplicate)</td>
                <td>High</td>
                <td>RQ-003</td>
            </tr>
            <tr>
                <td>TCond-004</td>
                <td>FS-002</td>
                <td>View registered courses when student has one or more enrolled courses</td>
                <td>Medium</td>
                <td>RQ-004</td>
            </tr>
            <tr>
                <td>TCond-005</td>
                <td>FS-002</td>
                <td>View registered courses when student has zero enrolled courses</td>
                <td>Low</td>
                <td>RQ-005</td>
            </tr>
        </tbody>
    </table>

