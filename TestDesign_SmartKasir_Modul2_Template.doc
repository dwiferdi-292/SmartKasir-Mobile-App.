    <h2 class="section-title">6. Test Design Technique Summary</h2>
    <table>
        <thead>
            <tr>
                <th width="18%">Test Condition ID</th>
                <th width="32%">Test Design Technique</th>
                <th width="50%">Rationale</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>TCond-001</td>
                <td>Equivalence Partitioning</td>
                <td>Classify valid cashier credentials from invalid combinations.</td>
            </tr>
            <tr>
                <td>TCond-002</td>
                <td>Equivalence Partitioning</td>
                <td>Verify system error response for invalid email or wrong password partition.</td>
            </tr>
            <tr>
                <td>TCond-003</td>
                <td>Equivalence Partitioning</td>
                <td>Verify mandatory input validation for empty credential fields.</td>
            </tr>
            <tr>
                <td>TCond-004</td>
                <td>Equivalence Partitioning</td>
                <td>Separate matching search terms from non-matching queries.</td>
            </tr>
            <tr>
                <td>TCond-006</td>
                <td>Equivalence Partitioning</td>
                <td>Verify cart addition for available inventory items (stock &gt; 0).</td>
            </tr>
            <tr>
                <td>TCond-007</td>
                <td>Boundary Value Analysis</td>
                <td>Verify boundary condition when stock reaches zero (stock = 0).</td>
            </tr>
            <tr>
                <td>TCond-008</td>
                <td>Boundary Value Analysis</td>
                <td>Verify boundary limits where cart quantity equals stock vs exceeds stock (stock + 1).</td>
            </tr>
            <tr>
                <td>TCond-009</td>
                <td>Boundary Value Analysis</td>
                <td>Verify boundary condition when paid amount exactly equals total bill (change = 0).</td>
            </tr>
            <tr>
                <td>TCond-010</td>
                <td>Equivalence Partitioning</td>
                <td>Verify change calculation when paid amount is greater than total bill.</td>
            </tr>
            <tr>
                <td>TCond-011</td>
                <td>Boundary Value Analysis</td>
                <td>Verify rejection boundary when paid amount is less than total bill (bill - 1).</td>
            </tr>
            <tr>
                <td>TCond-012</td>
                <td>Use Case Testing</td>
                <td>Verify end-to-end checkout flow, database commit, and inventory reduction.</td>
            </tr>
            <tr>
                <td>TCond-015</td>
                <td>Equivalence Partitioning</td>
                <td>Classify date range filters (Today, 7 Days, 30 Days) for sales records.</td>
            </tr>
            <tr>
                <td>TCond-017</td>
                <td>Boundary Value Analysis</td>
                <td>Verify alert triggers at stock boundary thresholds (stock &le; min_stock).</td>
            </tr>
            <tr>
                <td>TCond-018</td>
                <td>Equivalence Partitioning</td>
                <td>Verify positive integer restock inputs and audit log generation.</td>
            </tr>
            <tr>
                <td>TCond-020</td>
                <td>Use Case Testing</td>
                <td>Verify complete user session destruction and redirection flow upon logout.</td>
            </tr>
        </tbody>
    </table>

