        <tr><th colspan="2" style="background:#e2e8f0; font-size:11pt;">METADATA TEST PLAN</th></tr>
        <tr><td width="30%"><strong>Identifikasi Test Plan</strong></td><td width="70%">TP-SMARTKASIR-MOD1-202310370311292</td></tr>
        <tr><td><strong>Nama Aplikasi</strong></td><td>SmartKasir</td></tr>
        <tr><td><strong>Versi</strong></td><td>v1.2 (Revamped with Order History & Stock Management)</td></tr>
        <tr><td><strong>Peran yang Dipilih untuk Diuji</strong></td><td>Kasir</td></tr>
        <tr><td><strong>Nama Praktikan</strong></td><td>MUCHAMMAD DWI FERDI ILHAM ARIFIN</td></tr>
        <tr><td><strong>NIM</strong></td><td>202310370311292</td></tr>
        <tr><td><strong>Kelas</strong></td><td>PKPL - B</td></tr>
        <tr><td><strong>Tanggal Dibuat / Revisi</strong></td><td>16 Oktober 2026</td></tr>
