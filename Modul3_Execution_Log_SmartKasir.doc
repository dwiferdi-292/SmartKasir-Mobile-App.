        <thead>
            <tr><th>Raw ID</th><th>Q1</th><th>Q2</th><th>C (Tunai)</th><th>Total Tagihan (T)</th><th>Expected Output</th><th>Deduplication Decision</th></tr>
        </thead>
        <tbody>
            <tr><td align="center">1</td><td align="center">1</td><td align="center">25</td><td align="center">1.000.000</td><td>Rp 462.000</td><td>Sukses, Kembalian Rp 538.000</td><td><strong>Keep (Min Q1)</strong></td></tr>
            <tr><td align="center">2</td><td align="center">2</td><td align="center">25</td><td align="center">1.000.000</td><td>Rp 474.000</td><td>Sukses, Kembalian Rp 526.000</td><td><strong>Keep (Min+ Q1)</strong></td></tr>
            <tr><td align="center">3</td><td align="center">25</td><td align="center">25</td><td align="center">1.000.000</td><td>Rp 750.000</td><td>Sukses, Kembalian Rp 250.000</td><td><strong>Keep (Nominal Representative)</strong></td></tr>
            <tr><td align="center">4</td><td align="center">49</td><td align="center">25</td><td align="center">1.000.000</td><td>Rp 1.038.000</td><td>Tolak (C &lt; T, Uang Kurang)</td><td><strong>Keep (Max- Q1)</strong></td></tr>
            <tr><td align="center">5</td><td align="center">50</td><td align="center">25</td><td align="center">1.000.000</td><td>Rp 1.050.000</td><td>Tolak (C &lt; T, Uang Kurang)</td><td><strong>Keep (Max Q1)</strong></td></tr>
            <tr><td align="center">6</td><td align="center">25</td><td align="center">1</td><td align="center">1.000.000</td><td>Rp 318.000</td><td>Sukses, Kembalian Rp 682.000</td><td><strong>Keep (Min Q2)</strong></td></tr>
            <tr><td align="center">7</td><td align="center">25</td><td align="center">2</td><td align="center">1.000.000</td><td>Rp 336.000</td><td>Sukses, Kembalian Rp 664.000</td><td><strong>Keep (Min+ Q2)</strong></td></tr>
            <tr class="row-removed"><td align="center">8</td><td align="center">25</td><td align="center">25</td><td align="center">1.000.000</td><td>Rp 750.000</td><td>Sukses, Kembalian Rp 250.000</td><td>Remove: duplicate ID 3</td></tr>
            <tr><td align="center">9</td><td align="center">25</td><td align="center">49</td><td align="center">1.000.000</td><td>Rp 1.182.000</td><td>Tolak (C &lt; T, Uang Kurang)</td><td><strong>Keep (Max- Q2)</strong></td></tr>
            <tr><td align="center">10</td><td align="center">25</td><td align="center">50</td><td align="center">1.000.000</td><td>Rp 1.200.000</td><td>Tolak (C &lt; T, Uang Kurang)</td><td><strong>Keep (Max Q2)</strong></td></tr>
            <tr><td align="center">11</td><td align="center">25</td><td align="center">25</td><td align="center">750.000</td><td>Rp 750.000</td><td>Sukses Uang Pas, Kembalian Rp 0</td><td><strong>Keep (Min C)</strong></td></tr>
            <tr><td align="center">12</td><td align="center">25</td><td align="center">25</td><td align="center">751.000</td><td>Rp 750.000</td><td>Sukses, Kembalian Rp 1.000</td><td><strong>Keep (Min+ C)</strong></td></tr>
