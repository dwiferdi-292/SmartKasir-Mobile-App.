                <th>Penguji</th>
            </tr>
        </thead>
        <tbody>
            <tr><td><strong>TC-BVA-01</strong></td><td>RQ-004</td><td>BVA (Min a)</td><td>Login kasir, pilih 1 porsi F.Fries, 25 C.Latte, bayar Rp 1.000.000</td><td>Total Rp 462.000, kembalian Rp 538.000</td><td>Sesuai, struk terbit, kembalian Rp 538.000</td><td><span class="badge-pass">Lulus</span></td><td>2026-10-21</td><td>M. Dwi Ferdi</td></tr>
