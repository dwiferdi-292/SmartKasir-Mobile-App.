            <tr><td align="center">15</td><td align="center">25</td><td align="center">25</td><td align="center">2.000.000</td><td>Rp 750.000</td><td>Sukses, Kembalian Rp 1.250.000</td><td><strong>Keep (Max C)</strong></td></tr>
        </tbody>
    </table>

